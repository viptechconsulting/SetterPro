# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Solo usado en Edge Functions y API Routes (nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Unipile ───────────────────────────────────────────────────────────────────
# ⚠️  NUNCA exponer esta key al cliente. Solo API Routes / Edge Functions.
UNIPILE_API_KEY=your_unipile_api_key_here
UNIPILE_API_URL=https://api2.unipile.com:13465
UNIPILE_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
