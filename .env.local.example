# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Contraseña de DB (usada por scripts/run-migration.sh)
# Encuéntrala en: supabase.com > Project Settings > Database
SUPABASE_DB_PASSWORD=your_db_password_here

# ── Unipile (LinkedIn) ────────────────────────────────────────────────────────
UNIPILE_API_KEY=your_unipile_api_key_here
UNIPILE_API_URL=https://api2.unipile.com:13465
UNIPILE_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app
# NEXT_PUBLIC_APP_URL=http://localhost:3000   # para desarrollo local

# ── Admin ─────────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=info@viptechconsulting.com

# ── Email AI Draft System ─────────────────────────────────────────────────────
# Estas variables las configura n8n internamente.
# Agrégalas en: n8n > Settings > Variables
#
# QB_REALM_ID=123456789          → n8n Variable (Company ID de QuickBooks)
# TELEGRAM_CHAT_ID=-100XXXXXXX   → n8n Variable (Chat ID del grupo/canal)
# GMAIL_LABEL_AI_REVIEW=Label_XX → n8n Variable (ID del label de Gmail)
#
# Las credenciales OAuth (Gmail, QuickBooks, OpenAI, Telegram)
# se configuran en: n8n > Credentials
